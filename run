#!/bin/sh
# Run Tsk from this checkout. Works from any directory and through symlinks.
set -e
src=$0
while [ -L "$src" ]; do
	dir=$(cd -P "$(dirname "$src")" && pwd)
	src=$(readlink "$src")
	case $src in /*) ;; *) src=$dir/$src ;; esac
done
here=$(cd -P "$(dirname "$src")" && pwd)
entry=$here/src/cli.ts
# Node cannot strip TypeScript within node_modules; packed packages ship compiled JS.
case $here in */node_modules/*) entry=$here/dist/cli.js ;; esac
if command -v node >/dev/null 2>&1; then
	exec node "$entry" "$@"
fi
if command -v bun >/dev/null 2>&1; then
	exec bun "$entry" "$@"
fi
echo 'tsk: Node.js or Bun is required' >&2
exit 127
