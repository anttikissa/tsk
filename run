#!/bin/sh
# Resolve symlinks before locating the CLI, so a link in ~/.local/bin works.
script=$0
while [ -L "$script" ]; do
  directory=$(CDPATH= cd -P -- "$(dirname -- "$script")" && pwd) || exit 1
  target=$(readlink -- "$script") || exit 1
  case $target in
    /*) script=$target ;;
    *) script=$directory/$target ;;
  esac
done
root=$(CDPATH= cd -P -- "$(dirname -- "$script")" && pwd) || exit 1

case $root in
  */node_modules/*)
    entry=$root/dist/cli.js
    if [ ! -f "$entry" ]; then
      printf '%s\n' 'tsk: installed package is missing dist/cli.js' >&2
      exit 1
    fi
    ;;
  *) entry=$root/src/cli.ts ;;
esac

if command -v bun >/dev/null 2>&1; then
  exec bun "$entry" "$@"
elif command -v node >/dev/null 2>&1; then
  exec node "$entry" "$@"
else
  printf '%s\n' 'tsk: install Bun or Node.js (>=22.18) to run tsk' >&2
  exit 127
fi
