#!/bin/sh
# Resolve installation symlinks so the launcher works outside its checkout.
source=$0
while [ -L "$source" ]; do
  directory=$(CDPATH= cd -- "$(dirname -- "$source")" && pwd) || exit 1
  target=$(readlink -- "$source") || exit 1
  case "$target" in
    /*) source=$target ;;
    *) source=$directory/$target ;;
  esac
done
directory=$(CDPATH= cd -- "$(dirname -- "$source")" && pwd) || exit 1
case "$directory" in
  */node_modules/*|*/node_modules) entry=$directory/dist/cli.js ;;
  *) entry=$directory/src/cli.ts ;;
esac
if command -v bun >/dev/null 2>&1; then
  exec bun "$entry" "$@"
elif command -v node >/dev/null 2>&1; then
  exec node "$entry" "$@"
else
  echo 'tsk: Bun or Node.js is required' >&2
  exit 127
fi
