{
  "name": "@anttikissa/tsk",
  "version": "0.3.0",
  "description": "A minimal task manager for rebuilding software",
  "keywords": ["tasks", "cli", "agents", "llm"],
  "license": "MIT",
  "author": "Antti Kissaniemi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anttikissa/tsk.git"
  },
  "homepage": "https://github.com/anttikissa/tsk#readme",
  "type": "module",
  "bin": {
    "tsk": "./run"
  },
  "files": ["run", "dist/*.js", "src/*.ts", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": {
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "benchmark:scale": "bun run bench/scale.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
