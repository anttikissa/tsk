{
  "name": "@anttikissa/tsk",
  "version": "0.1.1",
  "description": "A minimal, Git-backed task manager for agents rebuilding software from small, reusable tasks.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/anttikissa/tsk.git" },
  "keywords": ["tasks", "task-manager", "agents", "git", "node", "bun"],
  "bin": { "tsk": "run" },
  "files": [
    "run",
    "dist/*.js",
    "src/cli.ts",
    "src/add.ts",
    "src/done.ts",
    "src/ason.ts",
    "src/init.ts",
    "src/project.ts",
    "src/show.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "tsk": "./run",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "tsc --project tsconfig.build.json"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
