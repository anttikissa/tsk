{
  "name": "@anttikissa/tsk",
  "version": "0.2.1",
  "description": "A minimal task manager for rebuilding software",
  "keywords": ["tasks", "cli", "agents", "llm"],
  "license": "MIT",
  "author": "Antti Kissaniemi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anttikissa/tsk.git"
  },
  "homepage": "https://github.com/anttikissa/tsk#readme",
  "type": "module",
  "bin": {
    "tsk": "run"
  },
  "files": [
    "run",
    "dist/*.js",
    "src/*.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.2",
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
