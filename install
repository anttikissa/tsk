#!/bin/sh
# Install Tsk from this checkout: dependencies, ~/.local/bin/tsk link, PATH hint.
# Safe to run repeatedly.
set -e
here=$(cd -P "$(dirname "$0")" && pwd)
bin_dir=$HOME/.local/bin
link=$bin_dir/tsk

if command -v bun >/dev/null 2>&1; then
	(cd "$here" && bun install)
elif command -v npm >/dev/null 2>&1 && command -v node >/dev/null 2>&1; then
	(cd "$here" && npm install --no-package-lock)
else
	echo 'install: Node.js with npm or Bun is required' >&2
	exit 1
fi

mkdir -p "$bin_dir"
if [ -L "$link" ] && [ "$(readlink "$link")" = "$here/run" ]; then
	echo "$link already links to $here/run"
elif [ -e "$link" ] || [ -L "$link" ]; then
	echo "install: $link already exists and is not a link to $here/run; remove it and rerun" >&2
	exit 1
else
	ln -s "$here/run" "$link"
	echo "Linked $link -> $here/run"
fi

case ":$PATH:" in *":$bin_dir:"*) exit 0 ;; esac

line='export PATH="$HOME/.local/bin:$PATH"'
case ${SHELL##*/} in
	zsh) rc=$HOME/.zshrc ;;
	bash) if [ "$(uname)" = Darwin ]; then rc=$HOME/.bash_profile; else rc=$HOME/.bashrc; fi ;;
	fish) rc=$HOME/.config/fish/config.fish; line='fish_add_path $HOME/.local/bin' ;;
	*) rc= ;;
esac
if [ -z "$rc" ]; then
	echo "$bin_dir is not on PATH. Add it in your shell startup file:"
	echo "  $line"
elif [ -f "$rc" ] && grep -qxF "$line" "$rc"; then
	echo "$rc already adds $bin_dir to PATH; open a new shell to use tsk"
else
	mkdir -p "$(dirname "$rc")"
	printf '\n# Added by Tsk install\n%s\n' "$line" >> "$rc"
	echo "Added $bin_dir to PATH in $rc; open a new shell to use tsk"
fi
