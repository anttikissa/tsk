#!/bin/sh
set -eu

root=$(CDPATH= cd -P -- "$(dirname -- "$0")" && pwd)
if command -v bun >/dev/null 2>&1; then
  (cd "$root" && bun install --frozen-lockfile)
elif command -v npm >/dev/null 2>&1; then
  (cd "$root" && npm install --no-audit --no-fund --no-package-lock)
else
  printf '%s\n' 'tsk: install Bun or Node.js and npm first' >&2
  exit 127
fi

bin=$HOME/.local/bin
link=$bin/tsk
mkdir -p "$bin"
if [ -L "$link" ]; then
  if [ "$(readlink "$link")" != "$root/run" ]; then
    printf 'tsk: refusing to replace %s (points elsewhere)\n' "$link" >&2
    exit 1
  fi
elif [ -e "$link" ]; then
  printf 'tsk: refusing to replace %s\n' "$link" >&2
  exit 1
else
  ln -s "$root/run" "$link"
fi

case :$PATH: in
  *:"$bin":*) printf 'tsk is ready: %s\n' "$link" ;;
  *) printf 'tsk is ready. Add %s to your PATH (for example, export PATH="%s:$PATH").\n' "$bin" "$bin" ;;
esac
