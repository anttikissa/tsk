#!/bin/sh
# Install dependencies and link ~/.local/bin/tsk to ./run. Safe to repeat.
set -e
dir=$(cd "$(dirname "$0")" && pwd -P)
cd "$dir"

if command -v bun >/dev/null 2>&1; then
	bun install
elif command -v npm >/dev/null 2>&1; then
	npm install
else
	echo 'install: Bun or Node.js (npm) is required' >&2
	exit 1
fi

bin=$HOME/.local/bin
link=$bin/tsk
mkdir -p "$bin"
if [ -L "$link" ]; then
	current=$(readlink "$link")
	if [ "$current" != "$dir/run" ]; then
		echo "install: $link points to $current; remove it to install this checkout" >&2
		exit 1
	fi
elif [ -e "$link" ]; then
	echo "install: $link exists and is not a symlink; refusing to overwrite it" >&2
	exit 1
else
	ln -s "$dir/run" "$link"
fi
echo "Linked $link -> $dir/run"

case ":$PATH:" in
	*":$bin:"*) ;;
	*)
		echo "$bin is not on your PATH. Add this line to your shell profile:"
		echo "  export PATH=\"\$HOME/.local/bin:\$PATH\""
		;;
esac
